# Update feed settings, read by build.sh and tools/release.sh.
# Leave EARL_FEED_URL empty and builds never check for updates.
# Environment variables of the same name override these values for one run.
# GitHub Releases host the files: each release carries the zip and appcast.xml,
# and "latest" always points at the newest release.
EARL_FEED_URL=https://github.com/IhsenBouallegue/earl/releases/latest/download/appcast.xml
# {TAG} becomes the release tag (v<version>-<build>) in tools/release.sh.
EARL_DOWNLOAD_BASE=https://github.com/IhsenBouallegue/earl/releases/download/{TAG}
# Public half of the update-signing key (the private half is in the login keychain).
EARL_SPARKLE_PUBLIC_KEY=4gLKTItdsxmF+VGIkKn+xfQ8SlNGuX+jTAlPJT/ADK8=
